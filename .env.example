# ========================================================
# ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO (PROYECTO DGL)
# Copia este archivo como .env.local y completa tus credenciales.
# ========================================================

# Google Gemini API Key
GEMINI_API_KEY=tu_api_key_de_gemini

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_supabase_publishable_anon_key
SUPABASE_SERVICE_ROLE_KEY=tu_supabase_service_role_key

# Supabase PostgreSQL Direct Connection (opcional, para scripts DDL)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.xxxxxxxxxxxxxxxxxxxx.supabase.co:5432/postgres

# Autenticación JWT / Sesiones
JWT_SECRET=tu_jwt_secret_aleatorio
